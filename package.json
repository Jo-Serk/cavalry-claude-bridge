{
  "name": "cavalry-claude-bridge",
  "version": "1.1.0",
  "description": "Let Claude read, edit and preview your Cavalry scenes (MCP server + one-click Claude Desktop extension).",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "cavalry",
    "mcp",
    "claude",
    "motion-design",
    "stallion"
  ],
  "scripts": {
    "build": "tsc --noEmit && node scripts/bundle.mjs",
    "test": "node test/e2e.mjs",
    "pack": "mcpb pack . dist/cavalry-claude-bridge.mcpb",
    "release:check": "npm run build && npm test && npm run pack"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "latest",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}